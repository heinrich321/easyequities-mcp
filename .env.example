# Easy Equities MCP — sample configuration
#
# Copy this file to one of the following locations and fill in real values:
#
#   ~/.config/easy-equities-mcp/.env        (recommended for personal use)
#   ./.env                                  (for local development)
#
# Or set the EE_MCP_ENV_FILE environment variable to an explicit path.
#
# Alternatively, you can skip the file entirely and put these variables in
# your MCP client config directly (e.g. the `env` block of
# claude_desktop_config.json).

# ---- Sessions -------------------------------------------------------------
#
# Each session is defined by three variables named
#     EE_SESSION_<NAME>_USERNAME
#     EE_SESSION_<NAME>_PASSWORD
#     EE_SESSION_<NAME>_PLATFORM   (optional; "easyequities" or "satrix")
#
# <NAME> becomes the lowercased session key you pass to the MCP tools
# (e.g. "personal", "tfsa"). You can define as many sessions as you like.

EE_SESSION_PERSONAL_USERNAME=your-username-or-email
EE_SESSION_PERSONAL_PASSWORD=your-password
EE_SESSION_PERSONAL_PLATFORM=easyequities

# Example second session (Satrix):
# EE_SESSION_TFSA_USERNAME=your-username-or-email
# EE_SESSION_TFSA_PASSWORD=your-password
# EE_SESSION_TFSA_PLATFORM=satrix

# ---- Optional overrides ---------------------------------------------------
#
# EE_MCP_ENV_FILE           Explicit path to a .env file (highest precedence).
# EE_MCP_COOKIE_DIR         Where to store session cookies.
#                           Defaults to ~/.easy-equities-mcp
